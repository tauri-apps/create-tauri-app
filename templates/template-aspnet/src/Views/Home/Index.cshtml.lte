<main class="container">
    <h1>Welcome to Tauri + ASP.NET</h1>

    <div class="row">
        <a href="https://tauri.app" target="_blank">
            <img src="img/tauri.svg" class="logo tauri" alt="Tauri logo"/>
        </a>
        <a href="https://dotnet.microsoft.com/en-us/apps/aspnet/" target="_blank">
            <img src="img/aspnet.svg" class="logo aspnet" alt="ASP.NET logo"/>
        </a>
    </div>
    <p>Click on the Tauri and ASP.NET logos to learn more.</p>

    <form id="greet-form" class="row">
        <input id="greet-input" placeholder="Enter a name..." />
        <button type="submit">Greet</button>
    </form>
    <p id="greet-msg"></p>
</main>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const msg = document.getElementById('greet-msg');
            const form = document.getElementById('greet-form');
            const input = document.getElementById('greet-input');

            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                try {
                    const greetMsg = await window.__TAURI__.{% if v2 %}core{% else %}tauri{% endif %}.invoke('greet', { name: input.value });
                    msg.textContent = greetMsg;
                } catch (error) {
                    console.error(error);
                    msg.textContent = `Error: ${error.message}`;
                }
            });
        });
    </script>
}