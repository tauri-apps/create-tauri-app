import { Component, signal } from "@angular/core";
import { RouterOutlet } from "@angular/router";
{% if specta %}import { commands } from "../bindings";{% else %}import { invoke } from "@tauri-apps/api/{% if v2 %}core{% else %}tauri{% endif %}";{% endif %}

@Component({
  selector: "app-root",
  imports: [RouterOutlet],
  templateUrl: "./app.component.html",
  styleUrl: "./app.component.css",
})
export class AppComponent {
  greetingMessage = signal("");

  greet(event: SubmitEvent, name: string): void {
    event.preventDefault();

    // Learn more about Tauri commands at {% if v2 %}https://tauri.app/develop/calling-rust/{% else %}https://v1.tauri.app/v1/guides/features/command{% endif %}
    {% if specta %}commands.greet(name){% else %}invoke<string>("greet", { name }){% endif %}.then((text) => {
      this.greetingMessage.set(text);
    });
  }
}
